{
  "$defs": {
    "boundedString": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "localItem": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "LOCAL",
            "USER",
            "TOOL",
            "LIMITATION"
          ],
          "type": "string"
        },
        "material": {
          "const": false
        },
        "summary": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "required": [
        "summary"
      ],
      "type": "object"
    },
    "localItems": {
      "items": {
        "$ref": "#/$defs/localItem"
      },
      "maxItems": 128,
      "type": "array"
    },
    "materialClaim": {
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "inferred": {
          "type": "boolean"
        },
        "material": {
          "const": true
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "summary": {
          "$ref": "#/$defs/boundedString"
        }
      },
      "required": [
        "summary",
        "material",
        "source_refs"
      ],
      "type": "object"
    },
    "materialClaims": {
      "items": {
        "$ref": "#/$defs/materialClaim"
      },
      "maxItems": 128,
      "type": "array"
    },
    "normalizedSource": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "maxLength": 64,
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 8,
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "url",
        "locator",
        "content_hash",
        "observed_at"
      ],
      "type": "object"
    },
    "normalizedSources": {
      "items": {
        "$ref": "#/$defs/normalizedSource"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "reviewProposal": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "const": false
        },
        "explicit_approval": {
          "const": true
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]+$",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "maxLength": 64,
          "type": "string"
        },
        "review_required": {
          "const": true
        },
        "review_state": {
          "const": "PROPOSED"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "required": [
        "explicit_approval",
        "review_state",
        "approved",
        "review_required",
        "proposal_id",
        "idempotency_key",
        "source_refs"
      ],
      "type": "object"
    },
    "sourceRef": {
      "pattern": "^S[1-9][0-9]{0,3}$",
      "type": "string"
    },
    "sourceRefs": {
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "https://schemas.anva.dev/skills/v1/prepare.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "GROUNDED"
          }
        }
      },
      "then": {
        "properties": {
          "anva_sources": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNVERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "affected_systems_and_owners": {
            "maxItems": 0
          },
          "anva_sources": {
            "maxItems": 0
          },
          "conflicts": {
            "maxItems": 0
          },
          "decisions_and_policies": {
            "maxItems": 0
          },
          "facts": {
            "maxItems": 0
          },
          "requirements": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "acceptance_criteria": {
      "$ref": "#/$defs/localItems"
    },
    "affected_systems_and_owners": {
      "$ref": "#/$defs/materialClaims"
    },
    "anva_sources": {
      "$ref": "#/$defs/normalizedSources"
    },
    "assumptions": {
      "$ref": "#/$defs/localItems"
    },
    "conflicts": {
      "$ref": "#/$defs/materialClaims"
    },
    "decisions_and_policies": {
      "$ref": "#/$defs/materialClaims"
    },
    "facts": {
      "$ref": "#/$defs/materialClaims"
    },
    "implementation_plan": {
      "$ref": "#/$defs/localItems"
    },
    "limitations": {
      "$ref": "#/$defs/localItems"
    },
    "out_of_scope": {
      "$ref": "#/$defs/localItems"
    },
    "problem": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "requirements": {
      "$ref": "#/$defs/materialClaims"
    },
    "status": {
      "enum": [
        "GROUNDED",
        "UNVERIFIED"
      ]
    },
    "unresolved_questions": {
      "$ref": "#/$defs/localItems"
    },
    "verification_plan": {
      "$ref": "#/$defs/localItems"
    }
  },
  "required": [
    "status",
    "problem",
    "facts",
    "requirements",
    "out_of_scope",
    "assumptions",
    "conflicts",
    "acceptance_criteria",
    "affected_systems_and_owners",
    "decisions_and_policies",
    "implementation_plan",
    "verification_plan",
    "unresolved_questions",
    "limitations",
    "anva_sources"
  ],
  "type": "object"
}
