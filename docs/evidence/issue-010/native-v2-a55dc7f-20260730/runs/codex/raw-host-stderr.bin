alse,"material":true,"source_refs":["S2"],"summary":"Use MOD_REGRADE_EXPORT_512DB828727F_BUCKET as the environment-variable name for the moderated-export object-store bucket configuration."},{"freshness":"CURRENT","inferred":false,"material":true,"source_refs":["S3"],"summary":"Obtain security review for both the schema migration and the exported student-data flow."}],"status":"GROUNDED","unresolved_questions":[{"basis":"LIMITATION","material":false,"summary":"Who owns the moderation API, browser UI, database migration, export worker, object-store configuration, and security review?"},{"basis":"LIMITATION","material":false,"summary":"Does the current background-download decision formally supersede ADR-19, and should ADR-19 be updated?"},{"basis":"LIMITATION","material":false,"summary":"What export format, fields, moderation scope, ordering, filename convention, and maximum data volume are required?"},{"basis":"LIMITATION","material":false,"summary":"What authorization, audit logging, encryption, retention, expiry, and download-link controls apply to exported student data?"},{"basis":"LIMITATION","material":false,"summary":"What job states, progress detail, polling or push mechanism, retry behavior, cancellation behavior, and failure messages must the browser support?"},{"basis":"LIMITATION","material":false,"summary":"What delivery deadline, query-performance budget, job-completion target, and object-size limit apply?"},{"basis":"LIMITATION","material":false,"summary":"What existing API operation will be extended, and what compatibility guarantees must be preserved?"}],"verification_plan":[{"basis":"LOCAL","material":false,"summary":"Run migration tests for forward application, rollback, existing-data compatibility, constraints, and indexes."},{"basis":"LOCAL","material":false,"summary":"Add API tests proving the existing moderation API initiates or reports exports, preserves authorization, and no second endpoint is introduced."},{"basis":"USER","material":false,"summary":"Add configuration tests proving the exact key MOD_REGRADE_EXPORT_512DB828727F_BUCKET is recognized and absent or incorrect configuration fails safely."},{"basis":"LOCAL","material":false,"summary":"Add worker or service tests for export contents, object-store upload, lifecycle transitions, retries, duplicate requests, and terminal failures."},{"basis":"USER","material":false,"summary":"Add browser tests covering pending or progress state, refresh or resume behavior, successful download, expired or unavailable artifacts, and failure display."},{"basis":"TOOL","material":false,"summary":"Complete and record security review of the migration and student-data export before release."},{"basis":"LIMITATION","material":false,"summary":"Define and then test performance and delivery thresholds once the missing budgets are supplied."}]}
