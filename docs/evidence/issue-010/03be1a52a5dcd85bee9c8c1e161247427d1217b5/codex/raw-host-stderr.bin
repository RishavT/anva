          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      }
    },
    "normalizedSources": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/normalizedSource"}
    },
    "materialClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "material", "source_refs"],
      "properties": {
        "summary": {"$ref": "#/$defs/boundedString"},
        "material": {"const": true},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "freshness": {
          "type": "string",
          "enum": ["CURRENT", "STALE", "UNKNOWN"]
        },
        "inferred": {"type": "boolean"}
      }
    },
    "localItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"$ref": "#/$defs/boundedString"},
        "material": {"const": false},
        "basis": {
          "type": "string",
          "enum": ["LOCAL", "USER", "TOOL", "LIMITATION"]
        }
      }
    },
    "materialClaims": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/materialClaim"}
    },
    "localItems": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/localItem"}
    },
    "reviewProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_approval",
        "review_state",
        "approved",
        "review_required",
        "proposal_id",
        "idempotency_key",
        "source_refs"
      ],
      "properties": {
        "explicit_approval": {"const": true},
        "review_state": {"const": "PROPOSED"},
        "approved": {"const": false},
        "review_required": {"const": true},
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]+$"
        },
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    }
  }
}


