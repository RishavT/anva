{
  "$id": "https://schemas.anva.dev/v1/acceptance-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "COMPLETE",
              "PARTIAL"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "knowledge_retrieval_results"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "knowledge_retrieval_results",
              "assurance_report",
              "findings",
              "criterion_evidence",
              "audit_log",
              "browser_capture",
              "structured_agent_output",
              "run_metadata"
            ],
            "type": "string"
          },
          "path": {
            "maxLength": 1000,
            "minLength": 9,
            "pattern": "^results/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\\\)[^/\\u0000]+(?:/[^/\\u0000]+)*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "corpus_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "error": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "message": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "manifest_sha256",
    "source_fingerprint",
    "run_id",
    "status",
    "started_at",
    "completed_at",
    "artifacts",
    "error"
  ],
  "title": "Anva Public Acceptance Result",
  "type": "object"
}
