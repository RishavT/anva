{
  "$defs": {
    "diff_chunk": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "SOURCE",
            "TEST",
            "DOCUMENTATION",
            "MIGRATION",
            "SECURITY_SENSITIVE",
            "DEPENDENCY",
            "CI"
          ],
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "new_count": {
          "minimum": 0,
          "type": "integer"
        },
        "new_start": {
          "minimum": 0,
          "type": "integer"
        },
        "old_count": {
          "minimum": 0,
          "type": "integer"
        },
        "old_start": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "type": "integer"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "position",
        "path",
        "classification",
        "old_start",
        "old_count",
        "new_start",
        "new_count",
        "text",
        "content_hash"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.anva.dev/v1/evaluator-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance_run_id": {
      "format": "uuid",
      "type": "string"
    },
    "authorized_context": {
      "items": {
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "deterministic_checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_AVAILABLE"
            ],
            "type": "string"
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "status",
          "blocking",
          "summary",
          "evidence_ids"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "evidence_mappings": {
      "items": {
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "instructions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "policy_controls": {
      "items": {
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "pull_request_revision_id": {
      "format": "uuid",
      "type": "string"
    },
    "repository_id": {
      "format": "uuid",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "type": "string"
    },
    "requirements": {
      "items": {
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "untrusted_change": {
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "items": {
            "$ref": "#/$defs/diff_chunk"
          },
          "maxItems": 2000,
          "type": "array"
        },
        "description": {
          "maxLength": 50000,
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "chunks"
      ],
      "type": "object"
    },
    "versions": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "diff_parser": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "evaluator": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "policy": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "prompt": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "requirements": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "diff_parser",
        "context",
        "requirements",
        "policy",
        "evidence",
        "evaluator",
        "prompt"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "organization_id",
    "repository_id",
    "assurance_run_id",
    "pull_request_revision_id",
    "commit_sha",
    "versions",
    "deterministic_checks",
    "requirements",
    "policy_controls",
    "evidence_mappings",
    "authorized_context",
    "untrusted_change",
    "instructions",
    "limitations"
  ],
  "title": "Anva Evaluator Request",
  "type": "object"
}
