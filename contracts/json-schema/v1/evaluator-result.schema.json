{
  "$defs": {
    "assurance_citation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "line": {
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "side": {
              "enum": [
                "OLD",
                "NEW"
              ],
              "type": "string"
            },
            "type": {
              "const": "DIFF"
            }
          },
          "required": [
            "type",
            "path",
            "side",
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "context_citation_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "ANVA_SOURCE"
            }
          },
          "required": [
            "type",
            "context_citation_id"
          ],
          "type": "object"
        }
      ]
    },
    "evaluator_finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "CORRECTNESS",
            "SECURITY",
            "RELIABILITY",
            "MAINTAINABILITY",
            "REQUIREMENT",
            "POLICY",
            "EVIDENCE"
          ],
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/assurance_citation"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "type": "string"
        },
        "criterion_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "explanation": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "BLOCKING",
            "HIGH",
            "MEDIUM",
            "LOW",
            "ADVISORY"
          ],
          "type": "string"
        },
        "suggested_resolution": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "uncertainty": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "category",
        "severity",
        "confidence",
        "title",
        "explanation",
        "citations",
        "evidence_ids",
        "criterion_codes",
        "uncertainty",
        "suggested_resolution"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.anva.dev/v1/evaluator-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "completion": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ],
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "evaluator_version": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/evaluator_finding"
      },
      "maxItems": 500,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "input_units": {
          "minimum": 0,
          "type": "integer"
        },
        "output_units": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_units",
        "output_units"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "organization_id",
    "commit_sha",
    "completion",
    "evaluator_version",
    "prompt_version",
    "usage",
    "findings",
    "limitations",
    "evaluated_at"
  ],
  "title": "Anva Evaluator Result",
  "type": "object"
}
