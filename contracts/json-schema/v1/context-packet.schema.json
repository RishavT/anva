{
  "$defs": {
    "context_item": {
      "additionalProperties": false,
      "properties": {
        "anva_sources": {
          "items": {
            "$ref": "#/$defs/retrieval_citation"
          },
          "minItems": 1,
          "type": "array"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "is_inferred": {
          "type": "boolean"
        },
        "item_id": {
          "format": "uuid",
          "type": "string"
        },
        "item_key": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "POLICY",
            "RELATIONSHIP",
            "ASSERTION",
            "SOURCE_EXCERPT",
            "DECISION",
            "INCIDENT",
            "CONFLICT"
          ],
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "rank_score": {
          "minimum": 0,
          "type": "number"
        },
        "selection_reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "kind",
        "item_key",
        "summary",
        "is_inferred",
        "freshness",
        "selection_reason",
        "rank_score",
        "payload",
        "anva_sources"
      ],
      "type": "object"
    },
    "retrieval_citation": {
      "additionalProperties": false,
      "properties": {
        "access_snapshot_id": {
          "format": "uuid",
          "type": "string"
        },
        "canonical_url": {
          "format": "uri",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "source_content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_location_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_observation_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "source_location_id",
        "source_observation_id",
        "access_snapshot_id",
        "canonical_url",
        "locator",
        "source_content_hash",
        "observed_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.anva.dev/v1/context-packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "max_citations": {
          "minimum": 1,
          "type": "integer"
        },
        "max_items": {
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "selected_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "selected_citations": {
          "minimum": 0,
          "type": "integer"
        },
        "selected_items": {
          "minimum": 0,
          "type": "integer"
        },
        "selected_tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_items",
        "max_tokens",
        "max_bytes",
        "max_citations",
        "selected_items",
        "selected_tokens",
        "selected_bytes",
        "selected_citations"
      ],
      "type": "object"
    },
    "completeness": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "object"
        },
        "complete": {
          "type": "boolean"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "exact_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "exact_eligible_assertions": {
          "minimum": 0,
          "type": "integer"
        },
        "exact_eligible_conflicts": {
          "minimum": 0,
          "type": "integer"
        },
        "ordering": {
          "const": "kind,id",
          "type": "string"
        },
        "page_size": {
          "minimum": 1,
          "type": "integer"
        },
        "partial_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "partial_retained_assertions": {
          "minimum": 0,
          "type": "integer"
        },
        "partial_retained_conflicts": {
          "minimum": 0,
          "type": "integer"
        },
        "processed_rows": {
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "ordering",
        "processed_rows",
        "digest",
        "complete",
        "page_size",
        "bindings"
      ],
      "type": "object"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "embedding_version": {
      "minLength": 1,
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "index_version": {
      "minLength": 1,
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/context_item"
      },
      "maxItems": 500,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "packet_id": {
      "format": "uuid",
      "type": "string"
    },
    "phase": {
      "enum": [
        "PREPARE",
        "BUILD",
        "PREFLIGHT",
        "ASSURANCE"
      ],
      "type": "string"
    },
    "repository_id": {
      "format": "uuid",
      "type": "string"
    },
    "request": {
      "type": "object"
    },
    "retrieval_algorithm_version": {
      "minLength": 1,
      "type": "string"
    },
    "retrieval_watermark": {
      "minimum": 1,
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "selection_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "work_item_id": {
      "oneOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "organization_id",
    "repository_id",
    "work_item_id",
    "revision",
    "generated_at",
    "content_hash",
    "phase",
    "request",
    "authorization_hash",
    "selection_hash",
    "retrieval_watermark",
    "retrieval_algorithm_version",
    "index_version",
    "embedding_version",
    "budget",
    "items",
    "limitations"
  ],
  "title": "Anva Context Packet",
  "type": "object"
}
