{
  "$defs": {
    "policy_binding": {
      "additionalProperties": false,
      "properties": {
        "entity_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "uniqueItems": true
        },
        "entity_types": {
          "items": {
            "enum": [
              "TEAM",
              "REPOSITORY",
              "SERVICE",
              "COMPONENT",
              "API",
              "DATA_ASSET",
              "DECISION",
              "POLICY",
              "REQUIREMENT",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "mandatory": {
          "type": "boolean"
        },
        "path_patterns": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\x00).*$",
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "uniqueItems": true
        },
        "repository_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "uniqueItems": true
        },
        "scope_level": {
          "enum": [
            "ORGANIZATION",
            "PRODUCT",
            "SYSTEM",
            "REPOSITORY",
            "PATH"
          ],
          "type": "string"
        },
        "target_branches": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "work_item_types": {
          "items": {
            "enum": [
              "FEATURE",
              "BUG",
              "SECURITY",
              "MIGRATION",
              "OPERATIONS",
              "OTHER"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "scope_level",
        "mandatory",
        "repository_ids",
        "entity_ids",
        "entity_types",
        "path_patterns",
        "work_item_types",
        "target_branches"
      ],
      "type": "object"
    },
    "policy_requirement": {
      "additionalProperties": false,
      "properties": {
        "check_type": {
          "enum": [
            "DETERMINISTIC",
            "EVIDENCE",
            "MODEL_REVIEW",
            "MANUAL_APPROVAL"
          ],
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "type": "string"
        },
        "description": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string"
        },
        "enforcement": {
          "enum": [
            "BLOCKING",
            "ADVISORY"
          ],
          "type": "string"
        },
        "report_sections": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required_approval": {
          "type": "boolean"
        },
        "required_evidence": {
          "items": {
            "enum": [
              "CHECK_STATUS",
              "TEST_RESULT",
              "BUILD_RESULT",
              "TYPECHECK_RESULT",
              "LINT_RESULT",
              "SCREENSHOT",
              "VIDEO",
              "CONSOLE_LOG",
              "NETWORK_TRACE",
              "API_ASSERTION",
              "STATIC_ANALYSIS",
              "SECURITY_SCAN",
              "DEPENDENCY_SCAN",
              "MIGRATION_RESULT",
              "PERFORMANCE_RESULT",
              "ACCESSIBILITY_RESULT",
              "MANUAL_APPROVAL",
              "SOURCE_REFERENCE",
              "DIFF_REFERENCE"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required_reviewers": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requirement_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "code",
        "description",
        "enforcement",
        "check_type",
        "required_evidence",
        "required_reviewers",
        "required_approval",
        "report_sections"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.anva.dev/v1/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_scope_id": {
      "format": "uuid",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/policy_binding"
    },
    "effective_at": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "oneOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "type": "string"
    },
    "owner": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    },
    "policy_id": {
      "format": "uuid",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/policy_requirement"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "DISABLED"
      ],
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "organization_id",
    "access_scope_id",
    "version",
    "name",
    "owner",
    "status",
    "effective_at",
    "expires_at",
    "binding",
    "requirements"
  ],
  "title": "Anva Assurance Policy",
  "type": "object"
}
