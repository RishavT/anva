# Local-development defaults. Change every credential outside local development.
ANVA_ENV=development
ANVA_DEBUG=true
ANVA_SECRET_KEY=local-only-change-me
ANVA_TOKEN_PEPPER=local-only-token-pepper
ANVA_TOKEN_ISSUER=anva-local
ANVA_TOKEN_AUDIENCE=anva-api
ANVA_BOOTSTRAP_SECRET=anva-local-bootstrap
ANVA_PUBLIC_BASE_URL=https://anva.example.com
ANVA_WEB_READ_ONLY=false
ANVA_GITHUB_WEBHOOK_SECRETS=replace-with-github-webhook-secret
ANVA_GITHUB_APP_ID=123456
ANVA_GITHUB_APP_SLUG=anva-example
# The PEM stays outside the image and is mounted only into the `github-worker` profile.
ANVA_GITHUB_APP_PRIVATE_KEY_FILE_HOST=./secrets/github-app-private-key.pem
ANVA_GITHUB_WORKER_POLL_SECONDS=5
ANVA_GITHUB_WORKER_LEASE_SECONDS=300
ANVA_ALLOWED_HOSTS=localhost,127.0.0.1,api,mcp
ANVA_POSTGRES_DB=anva
ANVA_POSTGRES_USER=anva
ANVA_POSTGRES_PASSWORD=anva-local-only
ANVA_DATABASE_URL=postgresql://anva:anva-local-only@postgres:5432/anva
ANVA_MINIO_ROOT_USER=anva-local
ANVA_MINIO_ROOT_PASSWORD=anva-local-only
ANVA_MINIO_BUCKET=anva
ANVA_OBJECT_STORAGE_ENDPOINT=http://minio:9000
ANVA_OBJECT_STORAGE_BUCKET=anva
ANVA_OBJECT_STORAGE_ACCESS_KEY=anva-local
ANVA_OBJECT_STORAGE_SECRET_KEY=anva-local-only
ANVA_OBJECT_STORAGE_REGION=us-east-1
ANVA_METRICS_TOKEN=replace-with-long-random-scrape-token
ANVA_RATE_LIMIT_ENABLED=true
ANVA_RATE_LIMIT_WINDOW_SECONDS=60
ANVA_RATE_LIMIT_API_REQUESTS=600
ANVA_RATE_LIMIT_MCP_REQUESTS=300
ANVA_RATE_LIMIT_WEB_REQUESTS=600
ANVA_RATE_LIMIT_PREAUTH_REQUESTS=1200
# Exact reverse-proxy IPs only. Forwarding headers from any other client are ignored.
ANVA_TRUSTED_PROXY_IPS=
ANVA_LOG_LEVEL=INFO
ANVA_WORKER_POLL_SECONDS=5
ANVA_WORKER_LEASE_SECONDS=300
# Colon-separated absolute roots that connectors may read. Mount each root read-only.
ANVA_FILESYSTEM_ALLOWED_ROOTS=/fixtures
ANVA_API_URL=http://api:8000/api/v1
ANVA_MCP_URL=http://mcp:8001/mcp
# Exact host allowlist for the server-side, bounded /diagnostics probe.
ANVA_MCP_ALLOWED_HOSTS=mcp
ANVA_API_PORT=18080
ANVA_MCP_PORT=18081
ANVA_MINIO_API_PORT=19000
ANVA_MINIO_CONSOLE_PORT=19001
ANVA_BACKUP_DIR=./backups
ANVA_VERSION=0.1.0
ANVA_REVISION=replace-with-release-commit
ANVA_IMAGE_REPOSITORY=anva
# For release scans on Linux, set this to: stat -c '%g' /var/run/docker.sock
# ANVA_DOCKER_GID=replace-with-docker-socket-group-id
SOURCE_DATE_EPOCH=1756684800
# Set these to `id -u` and `id -g` if your host account does not use 1000.
ANVA_HOST_UID=1000
ANVA_HOST_GID=1000
